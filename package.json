{
  "name": "muse-simlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node --experimental-strip-types --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "lint": "eslint src server --max-warnings=0",
    "test:e2e": "playwright test",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.2.2",
    "@tailwindcss/vite": "^4.3.4",
    "gsap": "^3.14.2",
    "lucide-react": "^0.468.0",
    "postprocessing": "^6.39.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.4",
    "three": "^0.181.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
